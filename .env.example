# Neon pooled connection string (or any Postgres URL).
# Local dev via docker: postgres://thesis:thesis@localhost:55432/thesis
DATABASE_URL=

# Reserved legacy deployment setting; current auth uses random opaque tokens
# and stores only their hashes in Postgres. Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret for the scheduled ingestion route. The external cron sends it as
#   Authorization: Bearer <CRON_SECRET>
# If unset, /api/ingest refuses every request rather than failing open.
CRON_SECRET=

# RECOMMENDED: the primary path for Ask THESIS's general finance chat.
# Never used by deterministic engines, and never given your watchlist,
# conditions, notes, quotes, events or anomalies. Server-side only. Without it,
# general questions fall back to the built-in concept table and anything outside
# it says so rather than guessing; grounded answers are unaffected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
