# Neon pooled connection string (or any Postgres URL).
# Local dev via docker: postgres://thesis:thesis@localhost:55432/thesis
DATABASE_URL=

# Reserved legacy deployment setting; current auth uses random opaque tokens
# and stores only their hashes in Postgres. Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret for the scheduled ingestion route. The external cron sends it as
#   Authorization: Bearer <CRON_SECRET>
# If unset, /api/ingest refuses every request rather than failing open.
CRON_SECRET=

# OPTIONAL: extends general finance education beyond the built-in concept table.
# Never used by deterministic engines, and never given your data. Server-side
# only. Leave blank: Ask THESIS answers grounded, general and advisory questions
# without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
