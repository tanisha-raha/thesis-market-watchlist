{
  "name": "thesis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "validate:source": "node --env-file-if-exists=.env.local --import tsx scripts/validate-source.ts",
    "smoke": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/smoke.ts",
    "browser-check": "tsx scripts/browser-check.ts",
    "seed:intraday": "node --env-file-if-exists=.env.local --import tsx scripts/seed-intraday.ts",
    "seed:load": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed-load.ts",
    "seed:daily": "node --env-file-if-exists=.env.local --import tsx scripts/seed-daily.ts",
    "test": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/tests.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
